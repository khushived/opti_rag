# ─── Application ────────────────────────────────────────────────────────────────
APP_NAME=OptiRAG
APP_ENV=development        # development | production
LOG_LEVEL=INFO

# ─── Ollama ─────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TEXT_MODEL=mistral
OLLAMA_VISION_MODEL=llava
OLLAMA_TIMEOUT=120         # seconds

# ─── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=86400      # 24 hours in seconds
REDIS_CACHE_PREFIX=opti_rag:cache:

# ─── Semantic Cache ──────────────────────────────────────────────────────────────
SEMANTIC_CACHE_THRESHOLD=0.92   # cosine similarity threshold (0.0 – 1.0)
SEMANTIC_CACHE_MAX_ENTRIES=10000

# ─── ChromaDB ───────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=rag_documents

# ─── Document Ingestion ─────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
CHUNK_SIZE=512             # tokens per chunk
CHUNK_OVERLAP=64           # overlap between consecutive chunks
TOP_K_RETRIEVAL=5          # number of chunks to retrieve

# ─── Generation ─────────────────────────────────────────────────────────────────
MAX_NEW_TOKENS=1024
TEMPERATURE=0.1
SYSTEM_PROMPT="You are a helpful assistant. Answer questions based only on the provided context. If the context does not contain enough information, say so clearly."
